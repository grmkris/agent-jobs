# Copy to .env.local (gitignored) and fill in. Nothing here is a real value; nothing real is ever committed.
# scripts/reality-check.ts (spike S-1) proves every entry with a real call; scripts/push-secrets.ts copies
# the Worker-side ones into Worker secrets per stage. See docs/implementation-plan.md and spec note 12 §13a.

# --- Networks ------------------------------------------------------------------------------------
MONAD_TESTNET_RPC_URL=
MONAD_MAINNET_RPC_URL=            # B7 only

# --- EOAs (testnet now; separate mainnet keys at B7) ---------------------------------------------
DEPLOYER_PRIVATE_KEY=             # deployer and admin of core, Holding, evaluator
DEPLOYER_ADDRESS=
RELAY_PRIVATE_KEY=                # relays signed authorisations; small MON balance
RELAY_ADDRESS=
ATTESTER_PRIVATE_KEY=             # signs EvidenceAttestation; registered verifier
ATTESTER_ADDRESS=
ARBITRATOR_PRIVATE_KEY=           # signs Ruling; the evaluator's arbitrator address
ARBITRATOR_ADDRESS=

# --- Verification --------------------------------------------------------------------------------
MONADSCAN_API_KEY=

# --- Cloudflare (alchemy staging = testnet, prod = mainnet) ---------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Indexer ------------------------------------------------------------------------------------
HYPERSYNC_API_TOKEN=

# --- GitHub App (attester + CRE workflow) ---------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=           # PEM, newlines as \n
GITHUB_APP_INSTALLATION_ID=
FIXTURE_REPO=                     # owner/name of the public fixture repo used by S-1

# --- Chainlink CRE (the CLI keeps its own login; these name the deployment) ----------------------
CRE_WORKFLOW_OWNER=
CRE_WORKFLOW_NAME=agent-jobs-evidence

# --- Privy ---------------------------------------------------------------------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_SERVER_WALLET_ID=           # the demo worker's server wallet
# Execution budget (ADR-0005): the board's signer, a Privy key quorum. Create once with
# bun --env-file=.env.local packages/board/scripts/budget-signer-key.ts (it appends both lines).
BUDGET_SIGNER_QUORUM_ID=
BUDGET_SIGNER_PRIVATE_KEY=

# --- MetaMask agent wallet (demo worker) --------------------------------------------------------
METAMASK_AGENT_WALLET_ADDRESS=

# --- Vercel AI Gateway (screening/Jev model calls and the arbiter) ----------------------------
AI_GATEWAY_API_KEY=               # a dedicated AI Gateway key, not a full Vercel account token
SCREENING_MODEL=                  # gateway model id used for Jev screening

# --- Arbitrator model endpoint (OpenAI-compatible: Muse Spark, Workers AI, Anthropic, ...) -------
ARBITER_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
ARBITER_MODEL=meta/muse-spark-1.3
ARBITER_MODEL_API_KEY=

# Testnet-only actors for scripts/testnet/flows.ts (creator/approver and the cast worker). Never used on mainnet.
TESTNET_CREATOR_PRIVATE_KEY=
TESTNET_CREATOR_ADDRESS=
TESTNET_WORKER_PRIVATE_KEY=
TESTNET_WORKER_ADDRESS=

# Overnight bounty campaign workers (testnet only)
CAMPAIGN_CLAUDE_PRIVATE_KEY=
CAMPAIGN_CLAUDE_ADDRESS=
CAMPAIGN_CODEX_PRIVATE_KEY=
CAMPAIGN_CODEX_ADDRESS=
CAMPAIGN_GROK_PRIVATE_KEY=
CAMPAIGN_GROK_ADDRESS=
CAMPAIGN_BAD_PRIVATE_KEY=
CAMPAIGN_BAD_ADDRESS=
CAMPAIGN_CLAUDE_AGENT_ID=
CAMPAIGN_CODEX_AGENT_ID=
CAMPAIGN_GROK_AGENT_ID=
CAMPAIGN_BAD_AGENT_ID=

# Overnight embed run (29/30 Sep 2026, testnet only): the JobPool curator, the Monad Pet host key that signs quest
# attestations and evidence, two pledger wallets, and the shared secrets of the Monad Pet Worker.
CURATOR_PRIVATE_KEY=
CURATOR_ADDRESS=
MONADPET_SERVER_PRIVATE_KEY=
MONADPET_SERVER_ADDRESS=
PLEDGER_A_PRIVATE_KEY=
PLEDGER_A_ADDRESS=
PLEDGER_B_PRIVATE_KEY=
PLEDGER_B_ADDRESS=
MONADPET_ATTEST_SECRET=
AGENT_JOBS_WEBHOOK_SECRET=
