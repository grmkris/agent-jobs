{
  "name": "sidequest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "scripts": {
    "check": "bun run typecheck && bun run test && bun test scripts/mining && bun run lint",
    "check:fast": "bun run typecheck && bun run lint",
    "typecheck": "tsc -p scripts/mining/tsconfig.json && turbo run typecheck",
    "test": "turbo run test --concurrency=2",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint:fix": "oxlint -c oxlint.config.ts --fix .",
    "build": "turbo run build",
    "dev": "alchemy dev --stage local",
    "deploy:dev": "node scripts/sidequest/dev-release.mjs",
    "dev:preflight": "node scripts/sidequest/dev-release.mjs plan",
    "sidequest:test": "node --test scripts/sidequest/*.test.mjs",
    "deploy:prod": "SIDEQUEST_NETWORK=monad-mainnet SIDEQUEST_STAGE=prod ALCHEMY_REMOTE_STATE=1 alchemy deploy --stage prod --yes",
    "alchemy": "alchemy",
    "reality-check": "bun scripts/reality-check.ts",
    "p0:drills": "bun scripts/p0-drills.ts",
    "mining:epoch": "bun scripts/mining/epoch.ts",
    "mining:publish": "bun scripts/mining/publish.ts",
    "mining:test": "bun test scripts/mining",
    "db:generate": "node scripts/db-generate.mjs",
    "testnet:v1:flows": "bun packages/sdk/scripts/v1-flows.ts",
    "live:deployed": "bun packages/sdk/scripts/live/deployed/acceptance.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "@effect/platform-bun": "catalog:",
    "turbo": "catalog:",
    "oxlint": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "contracts"
    ],
    "catalog": {
      "alchemy": "2.0.0-beta.81",
      "effect": "4.0.1",
      "@effect/platform-bun": "4.0.1",
      "@effect/platform-node": "4.0.1",
      "@effect/vitest": "4.0.1",
      "typescript": "7.0.2",
      "vite": "8.3.3",
      "vitest": "5.0.3",
      "@types/node": "22.20.5",
      "playwright-core": "1.63.0",
      "react": "19.3.0",
      "yaml": "2.9.1",
      "turbo": "2.11.7",
      "oxlint": "1.87.0",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "ajv": "8.17.1",
      "viem": "2.56.9",
      "@base-ui/react": "1.8.0",
      "@fontsource-variable/geist": "5.3.0",
      "@number-flow/react": "0.6.2",
      "@paper-design/shaders-react": "0.0.81",
      "@privy-io/react-auth": "3.45.0",
      "@tanstack/react-query": "5.104.0",
      "class-variance-authority": "0.7.1",
      "cn": "0.3.2",
      "fumadocs-core": "16.16.2",
      "lucide-react": "1.48.0",
      "react-dom": "19.3.0",
      "tw-animate-css": "1.4.0",
      "wagmi": "3.7.7",
      "@monad-crypto/token-list": "2.49.0",
      "@tailwindcss/vite": "4.3.3",
      "@vitejs/plugin-react": "6.1.1",
      "@web3icons/common": "0.11.53",
      "parse5": "8.0.0",
      "tailwindcss": "4.3.3",
      "@tanstack/react-start": "1.168.60",
      "@tanstack/start-static-server-functions": "1.167.39",
      "fumadocs-mdx": "15.4.6",
      "fumadocs-ui": "npm:@fumadocs/base-ui@16.16.2",
      "mdast-util-to-markdown": "2.2.0",
      "unist-util-visit": "5.1.0",
      "zod": "4.4.3",
      "@types/mdast": "4.0.4",
      "@types/mdx": "2.0.14",
      "@types/unist": "3.0.3",
      "mdast-util-mdx": "3.0.0",
      "remark-frontmatter": "5.0.0",
      "remark-gfm": "4.0.1",
      "remark-mdx": "3.1.1",
      "remark-parse": "11.0.0",
      "unified": "11.0.5",
      "@metamask/delegation-core": "3.0.0",
      "@metamask/delegation-deployments": "2.1.0"
    }
  },
  "overrides": {
    "effect": "4.0.1",
    "@effect/platform-bun": "4.0.1",
    "@effect/platform-node": "4.0.1",
    "@effect/platform-node-shared": "4.0.1",
    "@effect/vitest": "4.0.1",
    "@effect/sql-d1": "4.0.1",
    "@effect/sql-sqlite-do": "4.0.1"
  },
  "trustedDependencies": [
    "workerd"
  ]
}
